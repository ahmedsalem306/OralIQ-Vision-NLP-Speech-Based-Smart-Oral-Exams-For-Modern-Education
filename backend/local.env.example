# انسخ إلى local.env وعدّل القيم (لا ترفع local.env على Git)

# ── Required in production ────────────────────────────────────────────────────
# The server refuses to start without these two whenever ENV is not "dev".

# Signs every access token. Generate once and keep the same value for the life of the
# deployment: change it and every signed-in user is logged out, mid-exam included.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# The sites allowed to call this API, comma separated. "*" is rejected in production.
# ALLOWED_ORIGINS=https://oraliq.com,https://www.oraliq.com

# Anything other than "dev" is production: /debug and /docs close, and the two above
# become mandatory.
# ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Without DATABASE_URL the app falls back to a local SQLite file, which is fine for
# development and not for a server.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# For migrations (ALTER TABLE) on Supabase — use direct connection port 5432:
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Grading throughput ────────────────────────────────────────────────────────
# How many answers are transcribed and graded at the same time. Each job wants a few
# cores and roughly 2GB, so this is the setting that decides how many students an
# instance can serve at once; requests past it queue rather than fail.
# Default: cores / 4. On an 8-core box, 2 is a sensible starting point.
# MAX_CONCURRENT_GRADING=2

# Cores per transcription. Default: cores / MAX_CONCURRENT_GRADING.
# WHISPER_CPU_THREADS=4

# "medium" is the default and is what the accuracy was tuned on. "small" roughly halves
# both the memory and the time, at a real cost in Arabic accuracy.
# WHISPER_MODEL=medium

# ── Behind a reverse proxy ────────────────────────────────────────────────────
# Set this only when nginx (or another proxy you control) sits in front and sets
# X-Forwarded-For. Switched on without such a proxy, any caller can claim any IP.
# TRUST_PROXY=true

# Requests per minute per signed-in session, or per IP for anonymous callers.
# RATE_LIMIT_PER_MIN=240

GEMINI_API_KEY=your-gemini-api-key
