# Secrets — never commit these. `.env` alone would miss .env.production and friends.
.env*
# These two hold only the API URL the build points at — no secrets, and they are in the repo.
# Scoped to frontend/ on purpose: a backend .env.production would hold the real credentials.
!frontend/.env.development
!frontend/.env.production
!deploy/contabo/.env.example
!ops/loadtest/.env.example
*.env
!local.env.example
.secret_key
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.env
backend/local.env
backend/data/
backups/
*.db
interview_ai.db

# Frontend
node_modules/
dist/
.DS_Store
frontend/.env.local

# IDE / tools / scratch
.vscode/
.idea/
.claude/
.agents/
.prev-photos/
hf-space-clone_v2/

# Local-only
test_face_detection.py
yolo26n.pt
face_landmarker.task

# Tool outputs and caches
graphify-out/
.pytest_cache/
.pytest-tmp*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
students.load.json
security-*-audit.json
/security-*.txt
loadtest-artifacts/

